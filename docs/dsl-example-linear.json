{
  "flowId": "wf-linear-demo",
  "nodes": [
    {
      "id": "node-start::001",
      "data": {
        "nodeMeta": {
          "title": "Start",
          "description": "Entry point — receives user query"
        },
        "inputs": [
          {
            "name": "query",
            "type": "string",
            "value": "tell me about Java"
          }
        ]
      }
    },
    {
