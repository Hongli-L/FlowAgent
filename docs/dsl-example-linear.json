        "nodeParam": {
          "model": "gpt-4o-mini",
          "temperature": 0.7
        },
        "retryConfig": {
          "shouldRetry": true,
          "maxRetries": 2,
          "retryInterval": 1000,
          "timeOutEnabled": true,
          "toMillis": 30000,
          "errorStrategy": "err_interrupt"
        }
      }
    },
    {
      "id": "node-end::003",
      "data": {
        "nodeMeta": {
          "title": "End",
          "description": "Terminal node — outputs LLM response"
        },
        "inputs": [
          {
            "name": "answer",
            "type": "string",
            "value": "{{llm::002.outputs.text}}"
          }
        ]
      }
    }
